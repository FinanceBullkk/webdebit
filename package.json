    "test:browser": "node --test cong-no-web-handoff/preview/test-customer-ledger-browser.js cong-no-web-handoff/preview/test-so-khach-v7-offset-browser.js",
    "test:viewer": "node --test cong-no-web-handoff/tests/test-viewer-browser.js"
  },
  "devDependencies": {
