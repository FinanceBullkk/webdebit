{
  "name": "webdebit",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "npm run check:loc && npm run test:loc && npm run spec:check && npm run test:unit && npm run test:browser",
    "check:loc": "node scripts/check-loc.mjs",
    "test:loc": "node --test scripts/check-loc.test.mjs",
    "spec:check": "openspec validate --all --strict --no-interactive",
    "test:unit": "node --test cong-no-web-handoff/preview/test-so-cong-no-model.js cong-no-web-handoff/preview/test-monthly-ledger-model.js cong-no-web-handoff/preview/test-customer-ledger-workbench.js cong-no-web-handoff/preview/test-customer-ledger-requirements.js",
    "test:browser": "node --test cong-no-web-handoff/preview/test-customer-ledger-browser.js"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.2",
    "playwright": "1.64.1"
  }
}
